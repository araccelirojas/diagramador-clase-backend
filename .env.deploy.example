# Plantilla de los secretos del despliegue en AWS.
#
# No hace falta copiarla a mano: la primera vez que ejecutes ./infra/aws-up.sh
# se genera .env.deploy con POSTGRES_PASSWORD y JWT_SECRET ya aleatorios.
# Esta copia esta aqui para saber que contiene y que poner en los secretos de
# GitHub si despliegas desde el pipeline.

# Contrasena de PostgreSQL dentro de la instancia.
POSTGRES_PASSWORD=

# Firma de los JWT. Cambiarlo cierra todas las sesiones abiertas.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Opcional. Sin clave, /api/boceto y /api/voz responden 503 y el resto de la
# API funciona igual.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=90000
OPENAI_VOZ_MODELO=gpt-realtime-2.1-mini
OPENAI_VOZ=marin

BOCETO_MAX_BYTES=10485760
AUTOSAVE_INTERVAL_MS=15000
AUTO_MIGRATE=true
