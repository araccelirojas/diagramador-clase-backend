# Plantilla para desplegar A MANO con ./infra/aws-deploy.sh (el pipeline no la
# usa: toma los secretos de GitHub).
#
# Copiala a .env.deploy y rellenala con los valores de infra/secretos-github.txt,
# que genera ./infra/aws-up.sh. POSTGRES_PASSWORD tiene que ser el mismo del
# primer despliegue. Exporta tambien APP_DOMAIN antes de lanzar el script.

# Contrasena de PostgreSQL dentro de la instancia.
POSTGRES_PASSWORD=

# Firma de los JWT. Cambiarlo cierra todas las sesiones abiertas.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Opcional. Sin clave, /api/boceto y /api/voz responden 503 y el resto de la
# API funciona igual.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=90000
OPENAI_VOZ_MODELO=gpt-realtime-2.1-mini
OPENAI_VOZ=marin

BOCETO_MAX_BYTES=10485760
AUTOSAVE_INTERVAL_MS=15000
AUTO_MIGRATE=true
