generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Diagram {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  nodes       Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("diagrams")
}
