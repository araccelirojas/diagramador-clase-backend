# Servidor
PORT=3000
NODE_ENV=development
# Origenes del frontend autorizados, separados por coma. Vacio = cualquiera.
CORS_ORIGIN=http://localhost:5173

# Colaboracion: cada cuantos ms guarda una sala. Uno por sala, no por persona.
AUTOSAVE_INTERVAL_MS=15000

# PostgreSQL
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diagramador?schema=public"

# Autenticacion
# Genera uno propio con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=10

# Migraciones
# true (por defecto): aplica las migraciones pendientes al arrancar el servidor.
AUTO_MIGRATE=true

# Lectura de bocetos (importar diagrama desde una foto).
# Sin OPENAI_API_KEY la funcionalidad responde 503 y el resto sigue funcionando.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=90000
BOCETO_MAX_BYTES=10485760

# IA del chat de la sala (CU-02). Sin OPENAI_CHAT_MODEL usa OPENAI_MODEL.
OPENAI_CHAT_MODEL=
IA_TIMEOUT_MS=60000
# Cuando la IA cambia el diagrama (CU-04) usa herramientas, y un modelo de razonamiento solo
# las acepta con reasoning_effort "none". Dejalo vacio si el modelo no es de razonamiento.
IA_RAZONAMIENTO_HERRAMIENTAS=none

# Notas de voz del chat (CU-03). Los audios se guardan en disco: en Docker, un volumen.
AUDIO_DIR=
AUDIO_MAX_BYTES=10485760
AUDIO_MAX_MS=120000
OPENAI_TRANSCRIPCION_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Historial de versiones (CU-05). Una automatica cada 10 minutos de edicion como mucho,
# y se guardan las ultimas 50 automaticas; las manuales no se borran nunca.
VERSION_AUTO_MS=600000
VERSIONES_AUTO_MAX=50

# Llamada de voz grupal con Jarvis. Cada navegador transcribe su microfono para oir cuando
# alguien dice "Jarvis"; la respuesta la da la IA del chat (OPENAI_CHAT_MODEL / OPENAI_MODEL).
OPENAI_LLAMADA_TRANSCRIPCION_MODEL=gpt-4o-mini-transcribe
# Opcional: servidor TURN para redes que bloquean la conexion directa entre navegadores.
# Sin el se usa solo STUN, que alcanza en la mayoria de las redes.
LLAMADA_TURN_URL=
LLAMADA_TURN_USUARIO=
LLAMADA_TURN_CLAVE=
