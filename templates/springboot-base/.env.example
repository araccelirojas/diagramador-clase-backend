# Copiá este fichero a `.env` si querés cambiar algo. NO hace falta para arrancar:
# cada clave de application.yml trae el mismo valor por defecto que figura aquí, así que
# sin .env el proyecto levanta igual. Las variables de entorno reales ganan sobre el .env.

# Puerto HTTP de la aplicación.
SERVER_PORT=8080

# Perfil activo. `default` = H2 en memoria, no necesita nada instalado.
# `postgres` = Postgres (ver docker-compose.yml). `postgres,prod` = Postgres con ddl-auto=validate.
SPRING_PROFILES_ACTIVE=default

# --- Conexión a Postgres. Solo se usan con el perfil `postgres`. -------------------
# Coinciden con lo que levanta docker-compose.yml, así que no hace falta tocarlas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=diagramador
DB_USER=postgres
DB_PASSWORD=postgres

# Orígenes permitidos por CORS, separados por comas. Por defecto, el dev server de Vite.
CORS_ORIGINS=http://localhost:5173

# Qué hace Hibernate con el esquema al arrancar:
#   update   crea y amplía tablas según las entidades (dev)
#   validate comprueba que el esquema coincide y no lo toca (producción)
#   none     no hace nada
JPA_DDL_AUTO=update

# true imprime en consola cada sentencia SQL que ejecuta Hibernate. Útil para ver qué
# genera el exportador; ruidoso para el uso normal.
JPA_SHOW_SQL=false

# --- Opcionales ------------------------------------------------------------------
# Nivel de log del código propio: TRACE, DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO
# Consola web de H2 en /h2-console. Solo aplica al perfil por defecto.
H2_CONSOLE=true
